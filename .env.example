# Environment variables for Event Butler.
# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable the app uses must be listed here with a dummy value.

# Postgres connection string (Neon). Set automatically on Vercel by the Neon integration (prefix EVENT_BUTLER_).
EVENT_BUTLER_DATABASE_URL=postgres://user:password@host/dbname

# Admin login (Auth.js with GitHub). Set in Vercel for all environments.
# Generate the secret with: openssl rand -base64 33
AUTH_SECRET=replace-with-a-random-secret
# From the GitHub OAuth App (Settings > Developer settings > OAuth Apps).
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
# Numeric GitHub account id of the organiser; only this account gets access.
ADMIN_GITHUB_ID=12345678
# Previews only: lets the login work via the production callback URL.
AUTH_REDIRECT_PROXY_URL=https://event-butler.vercel.app/api/auth

# Anonymous visitor statistics: secret used to hash visitor ids (rotates daily).
# Generate with: openssl rand -base64 33
VISIT_HASH_SECRET=replace-with-a-random-secret
